{
  "name": "agent-todo",
  "version": "0.1.0",
  "private": true,
  "description": "agent-todo：React Web + Bun/Elysia server + CLI 的 pnpm monorepo",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=20.19",
    "bun": ">=1.2",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @agent-todo/web dev",
    "dev:server": "pnpm --filter @agent-todo/server dev",
    "cli": "pnpm --filter @agent-todo/cli start",
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "lint": "oxlint",
    "clean": "rm -rf node_modules packages/*/node_modules packages/*/dist packages/*/.data"
  },
  "devDependencies": {
    "oxlint": "catalog:"
  }
}
