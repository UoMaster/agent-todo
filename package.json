{
  "name": "agent-todo",
  "version": "0.1.0",
  "private": true,
  "description": "agent-todo：React Web + Bun/Elysia server + CLI 的 pnpm monorepo",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22.18",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:all": "bash scripts/dev.sh",
    "dev:web": "pnpm --filter @agent-todo/web dev",
    "dev:server": "pnpm --filter @agent-todo/server dev",
    "cli": "pnpm --filter @agent-todo/cli start",
    "cli:link": "bash scripts/link-cli.sh link",
    "cli:unlink": "bash scripts/link-cli.sh unlink",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app",
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:web": "vitest run --project web",
    "coverage": "vitest run --coverage",
    "verify": "pnpm migrations:check && pnpm check && pnpm lint && pnpm test && pnpm coverage",
    "migrations:check": "sh scripts/check-migrations.sh",
    "migrations:new": "sh scripts/new-migration.sh",
    "postinstall": "git config core.hooksPath .githooks || true",
    "clean": "rm -rf node_modules packages/*/node_modules packages/*/dist packages/*/.data coverage"
  },
  "devDependencies": {
    "@vitest/coverage-istanbul": "catalog:",
    "oxlint": "catalog:",
    "vitest": "catalog:"
  }
}
